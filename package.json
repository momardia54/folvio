{
  "name": "folvio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "migrate": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/*.test.js",
    "test:runtime": "node --test tests/runtime/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "test:staging": "node scripts/test-staging.mjs",
    "prebuild": "node scripts/generate-migrations.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261103.0-beta",
    "puppeteer-core": "25.16.0",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "cloudflare": {
    "label": "Folvio",
    "bindings": {
      "ADMIN_USERNAME": {
        "description": "Administrator username. Add as a runtime secret after deployment if the setup flow does not prompt for it."
      },
      "ADMIN_PASSWORD": {
        "description": "Strong administrator password; store as a runtime secret."
      },
      "SESSION_SECRET": {
        "description": "Recommended random signing secret of at least 32 characters."
      }
    }
  },
  "description": "Self-hosted file collections on Cloudflare. Prepare folders, share scoped upload links, and manage client files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momardia54/folvio.git"
  },
  "homepage": "https://github.com/momardia54/folvio#readme",
  "bugs": {
    "url": "https://github.com/momardia54/folvio/issues"
  },
  "keywords": [
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "file-sharing",
    "file-upload",
    "self-hosted"
  ]
}
